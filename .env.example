# Pipeline (GitHub Actions) only. The client never touches the DB.
DATABASE_URL=

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Client reads the edition manifest from here (R2 public URL + /editions/latest.json)
NEXT_PUBLIC_MANIFEST_URL=

# Shared secret for POST /api/revalidate (called by the edition workflow)
REVALIDATE_SECRET=

# Unlocks /lab/* in production via ?key=
LAB_KEY=

# Optional fallback source. Do not enable until terms are checked (spec Section 15).
NEWSDATA_API_KEY=

# Publisher photos on lead stories. Default false (spec Section 4.6).
ENABLE_PHOTOS=false

NEXT_PUBLIC_ANALYTICS_ID=
