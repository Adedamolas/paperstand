# Vercel Blob store "paperstand-editions" (pipeline writes pages, manifests and its state).
# Pulled by `vercel env pull`; set as a GitHub Actions secret for the edition workflow.
BLOB_READ_WRITE_TOKEN=

# Client reads the edition manifest from here (Blob public URL + /editions/latest.json)
NEXT_PUBLIC_MANIFEST_URL=

# Shared secret for POST /api/revalidate (called by the edition workflow, with REVALIDATE_URL)
REVALIDATE_SECRET=
REVALIDATE_URL=

# Unlocks /lab/* in production via ?key=
LAB_KEY=

# Optional fallback source. Do not enable until terms are checked (spec Section 15).
NEWSDATA_API_KEY=

# Publisher photos on lead stories (halftone, credited). James approved for launch 2026-10-03.
ENABLE_PHOTOS=true

NEXT_PUBLIC_ANALYTICS_ID=
